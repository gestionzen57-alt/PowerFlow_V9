# V9 Kill Switches — fichier effectif sur la machine de Søn
# Créé 2026-07-14 par Hermes en session CEO autopilot.
# Voir config/v9_kill_switches.env.example pour la documentation complète.
# Source de vérité de l'activation : workspace/perplexity/memory/DECISIONS_LOG.md
# §"2026-07-14 — Motion CEO « débloque Phase 13, A1+A2+B+C+D, pas E »"

# Phase 13 (apprentissage réversible) — motion CEO 2026-07-14
V9_TRADER_MINI_ENABLED=1
V9_AUTO_CALIBRATOR_ENABLED=1

# P2 Shadow mode (commit 0c0c334) — rejoue shadow sur kill switches expérimentaux
V9_SHADOW_MODE_ENABLED=1

# P3-WIRE adaptive thresholds (commit 1babf14) — activé 2026-07-14
# Motion CEO Søn « go priorité 1 » — WIN/LOSS ≥ 50 (8423 résolues), 26 YAML _ADAPTIVE prêts,
# champs adaptatifs câblés, dégradation gracieuse testée. Activation = consommation des seuils
# adaptatifs par les 26 principes _ADAPTIVE (SHADOW). Promotion ACTIVE = décision séparée.
V9_ADAPTIVE_THRESHOLDS_WIRED_ENABLED=1

# Phase 12 (exécution réelle) — ACTIVÉ (Mode sécurisé)
V9_EXECUTION_ENABLED=1
V9_EXECUTION_SIMULATION=1

# Phase 14 — Learning offset (apprentissage pondération par WR observé)
# Activé 2026-07-15 par motion CEO Søn. 2 propositions APPROVED en attente :
# - haussiere WR 94% → multiplicateur 1.15
# - baissiere WR 65% → multiplicateur 1.15
# Le learning_offset_applier pondère la confiance de l'arbiter selon le WR
# observé par direction. Kill switch OFF = tout neutre (comportement identique).
V9_LEARNING_OFFSET_ENABLED=1

# Dynamic Risk Manager (commit e91838b) — cycles/phases SL/TP adaptatifs
# Validé sur 2000 décisions : 0 crash, 0 fallback, RR planifié 0.53→1.63.
# Activé 2026-07-17 par motion CEO Søn — pas d'attente, le système est prêt.
V9_DYNAMIC_RISK_ENABLED=1

# Symbol blacklist — motion CEO autopilot 2026-07-17
# USDCAD : WR=15.8% n=19, -3.08 pips/trade → paper-trade désactivé.
# Le système continue de lire USDCAD (forces/scenes/decisions) mais ne trade plus.
V9_BLACKLIST_SYMBOLS=USDCAD

# Phase A baissier — Long-only GBPUSD (commit fa8b4e9)
# Motion CEO 2026-07-18 : « Activer V9_GBPUSD_LONG_ONLY=1 en priorité,
# neutralise puits baissier 1% WR (3689 trades), réversible, aucun risque
# (edge haussier confirmé 100% WR sur 1088 trades) ».
# Implémentation : trade_engine.py section 1b — force direction='haussiere'
# pour GBPUSD uniquement, additif (R2) avec champ long_only_override dans
# le résultat. BearPerception + filtre devise restent en SHADOW/OFF
# (validation Phase B). À désactiver si edge haussier casse.
V9_GBPUSD_LONG_ONLY=1

# === Phase E — Système Prédictif (2026-07-18) ===
# Motion CEO Søn : « est-ce que le système est capable de prédire ?
# crée toi une skill de probabilité expert senior ».
# Tous ON par défaut (motion CEO « APPLY direct pour les modules à gain certain »).
# v9_cycle_memory reste OFF (SHADOW) — à activer après 30 jours live.

# v9_cycle_memory — mémoire inter-cycles des patterns résolus
V9_CYCLE_MEMORY_ENABLED=0

# v9_meta_strategy_optimizer — sélection contextuelle stratégies
V9_META_STRATEGY_OPTIMIZER_ENABLED=1

# v9_bayesian_predictor — calibration Platt + Beta-Binomial
V9_BAYESIAN_PREDICTOR_ENABLED=1

# v9_predictive_engine — Markov phase + Retournement risk
V9_PREDICTIVE_ENGINE_ENABLED=1

# v9_learn_loop — boucle d'apprentissage (ingestion + fit + backtest + walk-forward)
V9_LEARN_LOOP_ENABLED=1
