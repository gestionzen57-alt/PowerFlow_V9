# V9 Kill Switches — fichier effectif sur la machine de Søn
# Créé 2026-07-14 par Hermes en session CEO autopilot.
# Voir config/v9_kill_switches.env.example pour la documentation complète.
# Source de vérité de l'activation : workspace/perplexity/memory/DECISIONS_LOG.md
# §"2026-07-14 — Motion CEO « débloque Phase 13, A1+A2+B+C+D, pas E »"

# Phase 13 (apprentissage réversible) — motion CEO 2026-07-14
V9_TRADER_MINI_ENABLED=1
V9_AUTO_CALIBRATOR_ENABLED=1

# P2 Shadow mode (commit 0c0c334) — rejoue shadow sur kill switches expérimentaux
V9_SHADOW_MODE_ENABLED=1

# P3-WIRE adaptive thresholds (commit 1babf14) — activé 2026-07-14
# Motion CEO Søn « go priorité 1 » — WIN/LOSS ≥ 50 (8423 résolues), 26 YAML _ADAPTIVE prêts,
# champs adaptatifs câblés, dégradation gracieuse testée. Activation = consommation des seuils
# adaptatifs par les 26 principes _ADAPTIVE (SHADOW). Promotion ACTIVE = décision séparée.
V9_ADAPTIVE_THRESHOLDS_WIRED_ENABLED=1

# Phase 12 (exécution réelle) — ACTIVÉ (Mode sécurisé)
V9_EXECUTION_ENABLED=1
V9_EXECUTION_SIMULATION=1

# Phase 14 — Learning offset (apprentissage pondération par WR observé)
# Activé 2026-07-15 par motion CEO Søn. 2 propositions APPROVED en attente :
# - haussiere WR 94% → multiplicateur 1.15
# - baissiere WR 65% → multiplicateur 1.15
# Le learning_offset_applier pondère la confiance de l'arbiter selon le WR
# observé par direction. Kill switch OFF = tout neutre (comportement identique).
V9_LEARNING_OFFSET_ENABLED=1

# Dynamic Risk Manager (commit e91838b) — cycles/phases SL/TP adaptatifs
# Validé sur 2000 décisions : 0 crash, 0 fallback, RR planifié 0.53→1.63.
# Activé 2026-07-17 par motion CEO Søn — pas d'attente, le système est prêt.
V9_DYNAMIC_RISK_ENABLED=1

# Symbol blacklist — motion CEO autopilot 2026-07-17
# USDCAD : WR=15.8% n=19, -3.08 pips/trade → paper-trade désactivé.
# Le système continue de lire USDCAD (forces/scenes/decisions) mais ne trade plus.
V9_BLACKLIST_SYMBOLS=USDCAD

# Phase A baissier — Long-only GBPUSD (commit fa8b4e9)
# Motion CEO 2026-07-18 : « Activer V9_GBPUSD_LONG_ONLY=1 en priorité,
# neutralise puits baissier 1% WR (3689 trades), réversible, aucun risque
# (edge haussier confirmé 100% WR sur 1088 trades) ».
# Implémentation : trade_engine.py section 1b — force direction='haussiere'
# pour GBPUSD uniquement, additif (R2) avec champ long_only_override dans
# le résultat. BearPerception + filtre devise restent en SHADOW/OFF
# (validation Phase B). À désactiver si edge haussier casse.
V9_GBPUSD_LONG_ONLY=1

# === Phase E — Système Prédictif (2026-07-18) ===
# Motion CEO Søn : « est-ce que le système est capable de prédire ?
# crée toi une skill de probabilité expert senior ».
# Tous ON par défaut (motion CEO « APPLY direct pour les modules à gain certain »).
# v9_cycle_memory reste OFF (SHADOW) — à activer après 30 jours live.

# v9_cycle_memory — mémoire inter-cycles des patterns résolus
V9_CYCLE_MEMORY_ENABLED=0

# v9_meta_strategy_optimizer — sélection contextuelle stratégies
V9_META_STRATEGY_OPTIMIZER_ENABLED=1

# v9_bayesian_predictor — calibration Platt + Beta-Binomial
V9_BAYESIAN_PREDICTOR_ENABLED=1

# v9_predictive_engine — Markov phase + Retournement risk
V9_PREDICTIVE_ENGINE_ENABLED=1

# v9_learn_loop — boucle d'apprentissage (ingestion + fit + backtest + walk-forward)
V9_LEARN_LOOP_ENABLED=1

# === Niveau quantique P2+P3 — 2026-07-18 (motion CEO Søn) ===
# P2 — Position Manager (gestion active : break-even +30%, partial close +50%,
#      time-based exit stagnation 12 barres). Kill switch lu par core/v9/trade_engine.py
#      close_open_trades() ligne 767. R6 : fallback ExitSimulator si PM échoue.
V9_POSITION_MANAGER_ENABLED=1

# P3 — Market Regime Global (risk-on/off via force USD + sentiment).
#      Injecté dans DynamicRiskManager comme modulateur de TP (RISK_ON élargi,
#      RISK_OFF réduit). Kill switch lu par _market_regime_global_enabled()
#      core/v9/trade_engine.py ligne 104. R6 : retourne None si échec.
V9_MARKET_REGIME_GLOBAL_ENABLED=1

# === Filets de sécurité 2026-07-18 (motion CEO Søn 15h55 UTC) ===
# Audit DB live révèle catastrophe 17/07 : 4750 paper_trades GBPUSD,
# 99% baissier WR 1.07%, -46 735 pips. Cause = boucle re-entry
# sans cooldown + SL/TP calibrés M15 lissé (pas M1 réel).
# 3 filets additifs (R2) :

# NO_BAISSERE GLOBAL — bloque TOUT short (drift haussier structurel).
# Lecture : core/v9/trade_engine.py:115 _no_baissiere_enabled().
# Référencement : DECISIONS_LOG §2026-07-18 15h55.
V9_NO_BAISSIERE=1

# BearPerception — correction vitesse M1 réelle vs M15 lissé.
# Lecture : core/v9/v9_bear_perception.py BearPerceptionCorrection.
# Additif (R2) : ne modifie pas SL/TP, ajoute flags should_skip / fast_exit.
V9_BEAR_PERCEPTION_ENABLED=1

# Anti-boucle 17/07 — À CÂBLER core/v9/trade_engine.py (hors scope R22
# de cette session). Spécification :
#   V9_MIN_HOLD_BARS=1        : bloque re-entry si position ouverte < N barres
#                                sur même (symbol, direction). R6 défensif.
#   V9_MAX_OPEN_TRADES_PER_SYMBOL=3 : limite exposition par symbol. R30.
# Ces 2 vars sont documentées ici pour traçabilité mais NON actives
# (aucun code ne les lit). Cf. AUDIT_BOUCLES_20260718.md post-commit.

# === No-baissière GLOBAL (motion CEO 2026-07-18 §15h35) ===
# Edge baissier catastrophique = -56 178 pips sur 3709 trades (WR 1.21 %).
# Edge haussier sain = +8 850 pips sur 1108 trades (WR 98.83 %).
# Bilan global = -47 327 pips.
# Motion CEO « go long-only GBPUSD strict » : force `direction='haussiere'`
# pour TOUTES les paires (pas seulement GBPUSD). Additif (R2) :
# `no_baissiere_override` dans le résultat. Trade_engine section 1c.
# Idempotent : si V9_GBPUSD_LONG_ONLY=1 ET V9_NO_BAISSIERE=1, les deux
# overrides s'appliquent sans se contredire.

# === Fix B : Loop breaker générique anti-boucle re-entry (motion CEO §16h10) ===
# Crée core/v9/v9_loop_breaker.py. Garde-fou basé sur paper_trades DB :
# - V9_LOOP_BREAKER_ENABLED : kill switch principal (défaut OFF, motion CEO explicite)
# - V9_MIN_HOLD_BARS : secondes minimum entre 2 trades (symbol, direction)
# - V9_MAX_OPEN_TRADES_PER_SYMBOL : limite positions ouvertes par symbol
# - V9_LOOP_BREAKER_WINDOW_MINUTES : fenêtre glissante pour densité suspecte
# Ces 4 vars sont désormais CÂBLÉES dans le code (R2 additif strict).
# Activation : V9_LOOP_BREAKER_ENABLED=1 + tune les seuils selon marché.
V9_LOOP_BREAKER_ENABLED=0
V9_MIN_HOLD_BARS=60
V9_MAX_OPEN_TRADES_PER_SYMBOL=3
V9_LOOP_BREAKER_WINDOW_MINUTES=15

# === Fix C : TP/SL dynamiques par contexte (motion CEO §16h10) ===
# Crée core/v9/v9_dynamic_tp_sl.py. Fallback intelligent basé sur :
# - Magnitude historique OHLC (P50/P75 par symbol × timeframe)
# - vol_atr_pips si fourni
# Bornes R30 strictes : TP ∈ [5, 20], SL ∈ [5, 20].
# Ratio RR cible ≥ 0.7 (vs 0.53 actuel avec TP=8/SL=15 hardcodés).
V9_DYNAMIC_TP_SL_ENABLED=0
