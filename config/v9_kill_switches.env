# §"2026-07-14 — Motion CEO « débloque Phase 13, A1+A2+B+C+D, pas E »"

# Phase 13 (apprentissage réversible) — motion CEO 2026-07-14
V9_TRADER_MINI_ENABLED=1
V9_AUTO_CALIBRATOR_ENABLED=1

# P2 Shadow mode (commit 0c0c334) — rejoue shadow sur kill switches expérimentaux
V9_SHADOW_MODE_ENABLED=1

# P3-WIRE adaptive thresholds (commit 1babf14) — activé 2026-07-14
# Motion CEO Søn « go priorité 1 » — WIN/LOSS ≥ 50 (8423 résolues), 26 YAML _ADAPTIVE prêts,
# champs adaptatifs câblés, dégradation gracieuse testée. Activation = consommation des seuils
# adaptatifs par les 26 principes _ADAPTIVE (SHADOW). Promotion ACTIVE = décision séparée.
V9_ADAPTIVE_THRESHOLDS_WIRED_ENABLED=1

# Phase 12 (exécution réelle) — ACTIVÉ (Mode sécurisé)
V9_EXECUTION_ENABLED=1
V9_EXECUTION_SIMULATION=1

# Phase 14 — Learning offset (apprentissage pondération par WR observé)
# Activé 2026-07-15 par motion CEO Søn. 2 propositions APPROVED en attente :
# - haussiere WR 94% → multiplicateur 1.15
# - baissiere WR 65% → multiplicateur 1.15
# Le learning_offset_applier pondère la confiance de l'arbiter selon le WR
# observé par direction. Kill switch OFF = tout neutre (comportement identique).
V9_LEARNING_OFFSET_ENABLED=1
