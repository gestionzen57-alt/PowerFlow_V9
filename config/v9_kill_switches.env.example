# V9 Kill Switches — fichier d'activation runtime
# -----------------------------------------------
# Origine : motion CEO 2026-07-14 « go Fa debloque Phase 13 »
# (cf workspace/perplexity/memory/DECISIONS_LOG.md §2026-07-14)
#
# Convention : copier ce fichier vers `config/v9_kill_switches.env`
# et décommenter/modifier les switches à activer. Le fichier réel
# est gitignored (cf .gitignore) — ne JAMAIS commit une valeur
# effective, c'est une décision opérateur local.
#
# Lecture runtime : chaque module core/v9/* fait
#     os.environ.get("V9_<SWITCH>_ENABLED") == "1"
# avant d'agir. Toute valeur ≠ "1" (vide, "0", "false", ...) = OFF.
#
# Doctrine respectée :
# - R25' : switch descriptif, OFF par défaut dans le code, activation
#   explicite par CEO traçable (DECISIONS_LOG).
# - R8   : aucun core/v9/* n'est modifié pour poser le switch.
# - R18  : zéro réseau dans la lecture de ces env vars.
# - R26  : tests verts requis après chaque activation (pytest
#   tests/ -q --ignore=tests/test_telegram_notifier.py).

# === Phase 13 (apprentissage réversible) ===

# V9_TRADER_MINI_ENABLED
# Brief Q1 (2026-07-12) : injecte un multiplicateur proba WIN dans
# Arbiter.consolidate(), bornes [0.85, 1.05]. Modèle figé baseline v1.
# Effet : 0 si paper_trades / regime_snapshots vides.
# Activation CEO : 2026-07-14.
V9_TRADER_MINI_ENABLED=1

# V9_AUTO_CALIBRATOR_ENABLED
# Brief Q2 (2026-07-12) : cycle quotidien 03:00 UTC, propose-only,
# AUCUN auto-apply, journalise dans cognitive_journal + rapport JSON.
# Effet : no-op si paper_trades DYNAMIC vide.
# Activation CEO : 2026-07-14.
V9_AUTO_CALIBRATOR_ENABLED=1

# === Phase 12 (exécution réelle) — INTERDIT fondateur, NE PAS ACTIVER ===

# V9_EXECUTION_ENABLED
# Phase 12 fondateur. order_executor.py double-verrou
# (V9_EXECUTION_ENABLED=1 + HITL hitl_reviews pour lot>0.5).
# Activation = geste EXPLICITE et SÉPARÉ de Søn, jamais automatique.
# La doctrine R12 / R fondateur interdit l'auto-promotion.
# V9_EXECUTION_ENABLED=0
