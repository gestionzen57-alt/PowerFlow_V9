# PowerFlow V9 — Variables d'environnement (template)
# Copier ce fichier en `.env` (gitignoré) et remplacer les placeholders.
# Le `.env` est lu par scripts/v9_heartbeat.py et scripts/v9_telegram_notifier.py.

# ── Telegram (OBLIGATOIRE pour alertes heartbeat + notifier) ──
# Note 2026-07-18 : la config Telegram officielle est config/telegram.json
# (gitignoré). Les vars ci-dessous sont un FALLBACK historique (lus par
# v9_telegram_notifier uniquement pour la clé LLM, pas pour le bot Telegram).
# Pour faire tourner le chat IA bidirectionnel, il suffit que
# config/telegram.json contienne BOT_TOKEN + CHAT_ID valides.
#
# Créer un bot via @BotFather sur Telegram, récupérer le token.
TELEGRAM_BOT_TOKEN=<your_bot_token_here>
# Ton chat_id (numérique). Vérifier via @userinfobot.
TELEGRAM_CHAT_ID=<your_chat_id>
# Nom du bot (optionnel, informatif)
TELEGRAM_BOT_NAME=<your_bot_name>

# ── Exemple valeurs (NE PAS COMMITER de vraies valeurs) ──
# TELEGRAM_BOT_TOKEN=<your_bot_token_here>
# TELEGRAM_CHAT_ID=<your_chat_id>
# TELEGRAM_BOT_NAME=<your_bot_name>

# ── Bot Ipspx (chat IA, depuis 2026-07-18) ─────────────────
# Token réel pour le runtime (NE JAMAIS COMMITER le vrai token).
# Si tu tournes via le wrapper .bat, le token peut aussi venir d'une env var
# d'OS posée manuellement sur le VPS.
TELEGRAM_BOT_TOKEN_IPSPX=<your_ipspx_bot_token_here>

