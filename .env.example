# PowerFlow V9 — Variables d'environnement (template)
# Copier ce fichier en `.env` (gitignoré) et remplacer les placeholders.
# Le `.env` est lu par scripts/v9_heartbeat.py et scripts/v9_telegram_notifier.py.

# ── Telegram (OBLIGATOIRE pour alertes heartbeat + notifier) ──
# Créer un bot via @BotFather sur Telegram, récupérer le token.
TELEGRAM_BOT_TOKEN=<your_bot_token_here>
# Ton chat_id (numérique). Vérifier via @userinfobot.
TELEGRAM_CHAT_ID=<your_chat_id>
# Nom du bot (optionnel, informatif)
TELEGRAM_BOT_NAME=<your_bot_name>

# ── Exemple valeurs (NE PAS COMMITER de vraies valeurs) ──
# TELEGRAM_BOT_TOKEN=<your_bot_token_here>
# TELEGRAM_CHAT_ID=<your_chat_id>
# TELEGRAM_BOT_NAME=<your_bot_name>
