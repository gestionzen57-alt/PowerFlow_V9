# script, la carte de données et les hachages MD5 sont versionnés.
data/datasets/

# Mini-checkpoints auto-générés (v9_bootstrap.py, v9_market_open.py, v9_session_resume.py)
# — artefacts runtime, régénérables, hors DOC_REGISTRY.yml par définition
workspace/perplexity/mini_checkpoints/

# Backups de calibration skills — artefacts de session, jamais commités
docs/calibration/backups/

# Prompts temporaires Hermes (.hermes/)
.hermes/

# Backups .env.bak (créés par v9_ops.py --backup)
.env.bak*

# Backups data/ audit 2026-07-11 (P1-F DROP agent_event_bus traçabilité)
data/backups_audit_*/

# Scripts .bat générés localement (wrappers Telegram, etc.)
scripts/*.bat
# Exception : v9_run_with_kill_switches.bat (A1+A2 motion CEO 2026-07-14) —
# wrapper commit-able, ne contient pas de secret, ASCII pur cp1252.
!scripts/v9_run_with_kill_switches.bat
logs/agents/

# Sessions locales IDE/agent — non versionnées (sessions éphémères,
