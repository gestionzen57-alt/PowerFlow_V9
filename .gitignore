__pycache__/
*.pyc
.pytest_cache/

# Secrets locaux (.env) — JAMAIS COMMITÉ
# Contient TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, etc.
.env
.env.local
.env.*.local

# Config Telegram locale — jamais commitée
config/telegram.json

# Config + certificat auto-signé Dashboard web HITL (Brief Q3, 2026-07-12)
# — jamais commités (credentials + clé privée TLS)
config/dashboard.json
config/dashboard_certs/

# Kill switches runtime (config/v9_kill_switches.env) — moteur CEO autopilot
# 2026-07-14. Ne contient pas de secret, mais le fichier n'est créé que
# sur la machine de Søn (action opérateur). Idem pattern config/dashboard.json.
config/v9_kill_switches.env

# Artefact runtime notificateur Telegram
logs/.telegram_*

# Backups datés de fichiers core/v9/ avant chantier étendue (règle 28)
# Référence : DECISIONS_LOG.md 2026-07-07 'Doctrine V8 §3.1+§3bis import V9'
# Format : workspace/perplexity/memory/backups_AAAA-MM-JD/*.bak
workspace/perplexity/memory/backups_*/

# Artefact runtime watchdog heartbeat (scripts/v9_heartbeat.py)
# Compteur échecs + last_alive, régénéré à chaque cron
logs/.heartbeat_state.json

# Artefact runtime Telegram conversation (mémoire chat vers Hermes)
logs/.telegram_conversation.json

# DB et logs générés localement — jamais commités
data/*.db
data/*.db-wal
data/*.db-shm
# Backups DB horodatés (créés avant fix critique, ex. .bak_20260717_votedevise)
data/*.bak_*
logs/*.log
logs/*.log.*
logs/*.err
logs/*.pid
data/memory_live_test/

# Exports de calibration V9 (scripts/v9_calibration.py --export) — générés
# localement, jamais commités.
output/
memory/memory_temp.md

# Dataset V9-trader-mini (scripts/v9_export_dataset.py, Brief O5 2026-07-12)
